# Copy this file to ".env" and fill in your real Supabase connection string.
# Use the "Session pooler" string from Supabase (Connect button > Session
# tab), not the direct "db.xxxx.supabase.co" one — the direct one requires
# IPv6 and fails to connect on most home Wi-Fi. See docs/03-supabase-setup.md
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# Port the backend server runs on
PORT=4000
